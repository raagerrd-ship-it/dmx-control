[Unit]
Description=Audio → DMX engine (Node)
# Starta PARALLELLT med beroendena i stället för seriellt efter dem: att vänta in
# network/sound/dmx-helper la ~8s node-uppstart OVANPÅ kort-init:en. Motorn hakar
# på när de blir redo — dmx.ts återansluter till /run/dmx.sock och audio.ts
# respawnar arecord tills ljudkortet finns. Enda After: cpu-performance (så node
# kall-startar på full klock). Requires drar in dmx-helper, utan att blockera.
# (Inget network.target — showen behöver inget nätverk; :80 binder ändå.)
After=cpu-performance.service
Requires=dmx-helper.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/audio-dmx-engine
# HEAP-TAK 96 MB PER ISOLAT (var 112 i repot, 200 live pa Pi:n 09-27 = drift). MATT PA PC 2026-09-27 (tools/mem/,
# 600 s pop-facit genom showBench): levande heap ar 14-25 MB i huvudtraden och 11-16 MB i workern; V8 later heapen
# vaxa mot taket INNAN den gor Mark-Compact, sa taket bestammer heapTotal-toppen (200 -> 54 MB, 96 -> 30-40 MB) och
# darmed RSS. Flaggorna galler BADA isolaten (workern arver heap_size_limit, matt 136 MB vid 112+8).
# SEMI-SPACE 4 MB FAST (min=max). --max-semi-space-size=8 ensamt var verkningslost: V8 vaxer bara young-gen nar
# overlevnaden ar hog, och har overlever nastan inget -> semi stannade pa 8 MB i ALLA varianter (200/112/96/32).
# Med 4 MB fast: scavenge-median 0,40 ms (PC), 2x sa manga men kortare, young-gen 12 MB per isolat i stallet for 24
# (-24 MB RSS for tva isolat), heapTotal-topp 30 MB (var 38-54). Alternativ 2 MB: median 0,26 ms, 2,2 scavenges/s.
# Skrapet ar 43 kB/hop under uppvarmningen (ooptimerad kod boxar varje flyttal) och 1,2 kB/hop i stabilt lage -
# antal scavenges styrs av hur lange process() ar ooptimerad, inte av flaggorna.
# No --enable-source-maps: it parses every module's map at startup (slower cold
# boot on the SD card) and this is production — stack traces map to dist anyway.
ExecStart=/usr/bin/node --max-old-space-size=96 --min-semi-space-size=4 --max-semi-space-size=4 dist/index.js
Environment=NODE_ENV=production
Environment=UV_THREADPOOL_SIZE=2
Environment=PORT=80
Restart=always
RestartSec=2

# Higher scheduling priority than default user processes, lower than dmx-helper's
# realtime SCHED_FIFO. Reduces audio-tick jitter under load.
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=2

# Runs as root — this is a dedicated single-purpose appliance on an isolated
# network. Simplifies binding :80, ALSA access, and GPIO/serial permissions.
User=root

# Keep engine off the isolated realtime core (CPU3 reserved for dmx-helper).
CPUAffinity=1 2

[Install]
WantedBy=multi-user.target
