diff --git a/pi-dmx/engine/src/effects/kors.ts b/pi-dmx/engine/src/effects/kors.ts
new file mode 100644
index 0000000..2e3fc04
--- /dev/null
+++ b/pi-dmx/engine/src/effects/kors.ts
@@ -0,0 +1,21 @@
+import type { EffectDef } from "./types.js";
+import { hsv } from "./color.js";
+
+// KORS (prov 2026-10-23, nattagenten, opt-in DMX_KORS=1): refrängens helrigg-toggle. Båda grupperna lyser hela tiden (lamptrappan: refrängen
+// = hela riggen) i två palettkulörer en tredjedel isär, och grupperna BYTER kulör med varandra på varje slag - kulörerna korsar riggen.
+// Kicken pumpar hela riggen, den grupp som just fick ny kulör får slagets accent. Skäl: i toggle-låtar (låst takt = nästan varje låt sedan
+// löpande takten 10-19) har refrängen bara duel/backbeat/rave/gallop kvar efter glesningsregeln (25 lang: duel 20 % av kvällen).
+// Över 150 BPM byts kulören vartannat slag (högst ~1,25 byten/s per lampa).
+export const kors: EffectDef = {
+  key: "kors", label: "Kors", tier: "full", modulate: { energy: true, pulse: false }, section: ["high"], toggle: true,
+  desc: "Hela riggen i två kulörer som byter plats på varje slag - kicken pumpar.",
+  render(c) {
+    const step = (c.frame.bpm ?? 0) > 150 ? Math.floor(c.beatIdx / 2) : c.beatIdx;
+    const base = c.mixedSector(Math.floor(c.hueIdx / 8));
+    const mine = (c.group + step) & 1;                                   // vilken av de två kulörerna gruppen har nu
+    const hue = ((mine ? base + 2 : base) % 6) / 6;
+    const accent = mine ? c.beatPulse : c.beatPulse * 0.35;              // gruppen som just bytte till andra kulören får slaget
+    const v = 0.12 + 0.88 * Math.min(1, accent * 0.55 + c.drum.kick * 0.5 + c.punch * 0.3);
+    return hsv(hue, 1 - c.punch * 0.25, v);
+  },
+};
